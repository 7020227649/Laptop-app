<Window x:Class="LaptopInputControl.Installer.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laptop Input Shield Setup" 
        Height="440" Width="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0D0E13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1F2E" />
            <Setter Property="Foreground" Value="#C8CBD8" />
            <Setter Property="BorderBrush" Value="#2E3146" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2D40" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#262738" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" /> <!-- Custom Titlebar -->
                <RowDefinition Height="*" />  <!-- Wizard Steps -->
                <RowDefinition Height="64" /> <!-- Bottom Action Buttons -->
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Border Grid.Row="0" Background="#141520" BorderBrush="#222332" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Laptop Input Shield &amp; Controller — Setup Wizard" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F8" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Width="36" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnMinimizeClicked" ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol, Arial" FontSize="10" Foreground="#8E8EA6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Width="36" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnCloseClicked" ToolTip="Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets, Segoe UI Symbol, Arial" FontSize="10" Foreground="#8E8EA6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WIZARD STEP CONTAINER -->
            <Grid Grid.Row="1" Margin="28,16,28,8">
                
                <!-- STEP 1: OPTIONS / CONFIGURATION -->
                <Grid x:Name="StepConfig">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Install Laptop Input Shield" FontSize="18" FontWeight="Bold" Foreground="#F4F4F8" />
                        <TextBlock Text="Configure installation location and desktop shortcut preferences." FontSize="12" Foreground="#8E8EA6" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Destination Directory -->
                    <Border Grid.Row="1" Background="#141522" BorderBrush="#262738" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION FOLDER:" FontSize="11" FontWeight="Bold" Foreground="#8E8EA6" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInstallPath" Height="30" Background="#0D0E14" Foreground="#F4F4F8" BorderBrush="#2F3246" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,4" Click="OnBrowseClicked" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Shortcuts & Startup Options -->
                    <Border Grid.Row="2" Background="#141522" BorderBrush="#262738" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SHORTCUTS &amp; STARTUP:" FontSize="11" FontWeight="Bold" Foreground="#8E8EA6" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True" />
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Shortcut" IsChecked="True" />
                            <CheckBox x:Name="ChkStartWithWindows" Content="Launch automatically when Windows starts (Optional)" IsChecked="False" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- STEP 2: INSTALLING IN PROGRESS -->
                <Grid x:Name="StepInstalling" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="440">
                        <TextBlock Text="Installing Laptop Input Shield..." FontSize="16" FontWeight="Bold" Foreground="#F4F4F8" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="TxtInstallStatus" Text="Extracting application files..." FontSize="12" Foreground="#8E8EA6" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <ProgressBar x:Name="PrgBar" Height="8" Background="#141522" Foreground="#2563EB" BorderThickness="0" IsIndeterminate="True" />
                    </StackPanel>
                </Grid>

                <!-- STEP 3: FINISHED -->
                <Grid x:Name="StepFinished" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Width="52" Height="52" Background="#132E22" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="26" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="✓" FontSize="26" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Installation Complete!" FontSize="18" FontWeight="Bold" Foreground="#F4F4F8" HorizontalAlignment="Center" />
                        <TextBlock Text="Laptop Input Shield &amp; Controller is now ready to use on your PC." FontSize="12" Foreground="#8E8EA6" HorizontalAlignment="Center" Margin="0,4,0,16" />
                        <CheckBox x:Name="ChkLaunchApp" Content="Launch Laptop Input Shield now" IsChecked="True" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- BOTTOM ACTION BAR -->
            <Border Grid.Row="2" Background="#10111A" BorderBrush="#1E1F2C" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Version 1.3 • Compatible with Windows 10 &amp; 11" FontSize="11" Foreground="#7E8096" VerticalAlignment="Center" />
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,10,0" Click="OnCloseClicked" />
                        <Button x:Name="BtnInstall" Style="{StaticResource ActionButton}" Content="Install Now" Click="OnInstallClicked" />
                        <Button x:Name="BtnFinish" Style="{StaticResource ActionButton}" Content="Finish" Click="OnFinishClicked" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
